# Copy to .env (production) or .env.staging and fill in. Never commit the real file.
ENVIRONMENT=production            # production | staging
DOMAIN=forevertracker.org         # public hostname; Caddy obtains the TLS certificate
ACME_EMAIL=                       # required: Let's Encrypt sends certificate expiry notices here

# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
ADMIN_TOKEN=
CONTRIBUTOR_ID_SALT=              # changing it re-keys every contributor; set once

WEB_CONCURRENCY=2

# The desktop app release that installed apps update to and the Download page links to.
# Leave empty until the first signed installer is hosted; see "Releasing an update" in packaging/README.md.
UPLOADER_LATEST_VERSION=
UPLOADER_DOWNLOAD_URL=
UPLOADER_SHA256=
UPLOADER_SIGNED=false             # true once the installer is code-signed: drops the Windows-warning explainer
