  "$id": "https://forevertracker.org/schema/observation-batch.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The upload envelope. Observations are validated one by one after the envelope.",
  "properties": {
    "addon": {
      "$ref": "#/$defs/AddonInfo"
    },
    "batch_id": {
      "maxLength": 96,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9:_.-]+$",
      "title": "Batch Id",
      "type": "string"
    },
    "client": {
      "$ref": "#/$defs/ClientInfo"
    },
    "created_at": {
      "anyOf": [
        {
          "maximum": 4102444800,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "format": {
      "const": "forevertracker.batch",
      "title": "Format",
      "type": "string"
    },
    "installation_id": {
      "maxLength": 64,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Installation Id",
      "type": "string"
    },
    "observations": {
      "items": {
        "discriminator": {
          "mapping": {
            "character_snapshot": "#/$defs/CharacterSnapshotObservation",
            "dungeon_run": "#/$defs/DungeonRunObservation",
            "probe_report": "#/$defs/ProbeReportObservation"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DungeonRunObservation"
          },
          {
            "$ref": "#/$defs/CharacterSnapshotObservation"
          },
          {
            "$ref": "#/$defs/ProbeReportObservation"
          }
        ]
      },
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "schema_version",
    "batch_id",
    "installation_id",
    "observations"
  ],
  "title": "ForeverTracker observation batch, schema version 1",
  "type": "object"
}
